#!/bin/sh
# VS Code zero-code adapter launcher (ADR-0003 decision 14, Linux-first):
# exec the symrepl DAP server (cleanroom tree) on stdio.  A "debugServer"
# launch.json entry connects to an already-running server instead —
# that is how development and the nets drive it.  NOTE: schedule.py
# requires --lldb-dir; wiring it into the extension config is deferred
# with the VS Code application-scenario pin (2026-10-22).
exec python3 "$(dirname "$0")/../src/server/schedule.py" "$@"
